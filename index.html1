<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>RDX Multi-Asset Order Flow</title>
    <style>
        body { background-color: #0b0e14; color: #e1e6ed; font-family: Arial, sans-serif; padding: 15px; }
        .header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px; }
        select { background: #1a202c; color: #00ffcc; border: 1px solid #00ffcc; padding: 10px; border-radius: 6px; font-size: 16px; font-weight: bold; }
        .card { background: #161b22; border-radius: 8px; padding: 15px; margin-bottom: 15px; border: 1px solid #30363d; }
        .live { color: #00ffcc; font-weight: bold; }
        .imbalance { font-size: 18px; font-weight: bold; margin-top: 5px; }
        .green { color: #26a69a; } .red { color: #ef5350; }
    </style>
</head>
<body>
    <div class="header">
        <h2>RDX Order Flow Dashboard</h2>
        <select id="assetSelect" onchange="changeAsset()">
            <optgroup label="Crypto Pairs">
                <option value="BTCUSDT" selected>BTC/USDT (Bitcoin)</option>
                <option value="ETHUSDT">ETH/USDT (Ethereum)</option>
                <option value="SOLUSDT">SOL/USDT (Solana)</option>
                <option value="XRPUSDT">XRP/USDT (Ripple)</option>
            </optgroup>
            <optgroup label="Forex & Assets">
                <option value="EURUSD">EUR/USD (Forex)</option>
                <option value="GBPUSD">GBP/USD (Forex)</option>
                <option value="XAUUSD">XAU/USD (Gold)</option>
            </optgroup>
        </select>
    </div>

    <div class="card">
        <h3>Binance Futures Feed [<span id="bn-status" class="live">CONNECTING</span>]</h3>
        <p>Selected Pair: <b id="bn-symbol" style="color: #00ffcc;">BTCUSDT</b></p>
        <div class="imbalance">Depth Imbalance: <span id="bn-imb">0%</span></div>
    </div>

    <div class="card">
        <h3>Forex & Gold Live Feed [<span id="fx-status" class="live">LIVE</span>]</h3>
        <p>EUR/USD Bid: <b id="fx-bid" class="green">0.00</b> | Ask: <b id="fx-ask" class="red">0.00</b></p>
        <p>Status: <span id="fx-info">Live Public Feed</span></p>
    </div>

    <script>
        const ws = new WebSocket((window.location.protocol === 'https:' ? 'wss://' : 'ws://') + window.location.host + '/ws');
        
        ws.onmessage = function(event) {
            const data = JSON.parse(event.data);
            
            document.getElementById('bn-status').innerText = data.binance.status;
            document.getElementById('bn-symbol').innerText = data.symbol;
            document.getElementById('bn-imb').innerText = data.binance.depth_imbalance + '%';
            document.getElementById('bn-imb').className = data.binance.depth_imbalance >= 0 ? 'green' : 'red';
            
            if(data.oanda) {
                document.getElementById('fx-status').innerText = data.oanda.status;
                document.getElementById('fx-bid').innerText = data.oanda.bid;
                document.getElementById('fx-ask').innerText = data.oanda.ask;
                document.getElementById('fx-info').innerText = data.oanda.status_text;
            }
        };

        function changeAsset() {
            const selected = document.getElementById('assetSelect').value;
            ws.send(JSON.stringify({ change_symbol: selected }));
        }
    </script>
</body>
  </html>
